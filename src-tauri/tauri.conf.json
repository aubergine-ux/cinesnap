{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cinesnap",
  "version": "0.1.0",
  "identifier": "dev.cinesnap.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cinesnap",
        "width": 1360,
        "height": 860,
        "minWidth": 980,
        "minHeight": 640,
        "theme": "Dark",
        "backgroundColor": "#0d0e12"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": ["**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Video",
    "shortDescription": "Polished screen recordings, automatically",
    "longDescription": "Cinesnap records your screen and turns it into a polished demo video: automatic zooms on clicks, a smoothed cursor, and clean framing.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "11.0" }
  }
}
