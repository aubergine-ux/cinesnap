# Secret needed to upload, list and delete. Uploads are refused while this is empty.
# Generate one with: openssl rand -hex 24
UPLOAD_TOKEN=

# The address people will open, used in the links the server hands out.
# Leave empty to derive it from the request (Host / X-Forwarded-* headers).
PUBLIC_URL=

# Largest accepted upload in megabytes.
MAX_UPLOAD_MB=500

# Set to 1 when the server sits behind one reverse proxy (2 for two, and so on),
# so view counting sees the visitor's address instead of the proxy's.
TRUST_PROXY=

# Port on the host that Docker Compose publishes.
HOST_PORT=8080
